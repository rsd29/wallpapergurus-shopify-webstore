{% liquid
  assign background_color = section.settings.background_color
  assign hero_image = section.settings.image

  if background_color != blank
    render 'contrast-override', background_color: background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section class="about-page section section--full-width{% if background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div class="about-page__media">
    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 3000
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400, 3000',
          sizes: '100vw',
          class: 'about-page__image',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image_alt
      }}
    {% else %}
      <div class="about-page__placeholder" aria-hidden="true">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'about-page__placeholder-svg' }}
      </div>
    {% endif %}
  </div>

  {% if section.settings.story_copy != blank or section.settings.approach_copy != blank or section.settings.service_copy != blank %}
    <div class="about-page__story">
      {% if section.settings.story_copy != blank %}
        <article class="about-page__story-row">
          <h1 class="about-page__section-title">{{ section.settings.story_heading | escape }}</h1>
          <div class="about-page__copy">
            {{ section.settings.story_copy }}
          </div>
        </article>
      {% endif %}

      {% if section.settings.approach_copy != blank %}
        <article class="about-page__story-row">
          <h2 class="about-page__section-title">{{ section.settings.approach_heading | escape }}</h2>
          <div class="about-page__copy">
            {{ section.settings.approach_copy }}
          </div>
        </article>
      {% endif %}

      {% if section.settings.service_copy != blank %}
        <article class="about-page__story-row">
          <h2 class="about-page__section-title">{{ section.settings.service_heading | escape }}</h2>
          <div class="about-page__copy">
            {{ section.settings.service_copy }}
          </div>
        </article>
      {% endif %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .about-page__story {
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 2.5rem;
  }

  .about-page__story-row {
    display: grid;
    gap: 1rem;
  }

  .about-page__media,
  .about-page__image,
  .about-page__placeholder {
    width: 100%;
  }

  .about-page__image {
    display: block;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .about-page__story-row {
      grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About page",
  "tag": "section",
  "class": "about-page-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Large image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Wallpaper Gurus"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Wallpaper Gurus"
    },
    {
      "type": "richtext",
      "id": "story_copy",
      "label": "Story copy",
      "default": "<p>Wallpaper Gurus is a fourth-generation installation company based on the Gold Coast and Brisbane. We hang wallpaper for homes, commercial fit-outs, and designers who want the job done once and done properly.</p>"
    },
    {
      "type": "text",
      "id": "approach_heading",
      "label": "Approach heading",
      "default": "How we work"
    },
    {
      "type": "richtext",
      "id": "approach_copy",
      "label": "Approach copy",
      "default": "<p>We advise on quantities, source papers that install well, and prepare walls so the finish lasts. The shop is here so you can browse papers we know how to hang.</p>"
    },
    {
      "type": "text",
      "id": "service_heading",
      "label": "Service heading",
      "default": "Gold Coast and Brisbane"
    },
    {
      "type": "richtext",
      "id": "service_copy",
      "label": "Service copy",
      "default": "<p>We work with homeowners, builders, interior designers, and developers throughout Queensland, with projects further afield when the job calls for it.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "About page"
    }
  ]
}
{% endschema %}
