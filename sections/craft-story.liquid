{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="craft-story section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  <div
    class="craft-story__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.heading != blank or section.settings.lede != blank %}
      <header class="craft-story__mast">
        {% if section.settings.heading != blank %}
          <h2 class="craft-story__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
        {% if section.settings.lede != blank %}
          <p class="craft-story__lede">{{ section.settings.lede | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="craft-story__stage">
      <div class="craft-story__frames">
        <figure class="craft-story__frame craft-story__frame--video">
          <div class="craft-story__media">
            {% assign video_file = section.settings.video_file | default: 'craft-story.mp4' %}
            <video
              class="craft-story__video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="{{ 'craft-story-poster.jpg' | asset_url }}"
              aria-label="{{ section.settings.video_alt | escape }}"
            >
              <source src="{{ video_file | asset_url }}" type="video/mp4">
            </video>
          </div>
          {% if section.settings.video_caption != blank %}
            <figcaption class="craft-story__caption">{{ section.settings.video_caption | escape }}</figcaption>
          {% endif %}
        </figure>

        <div class="craft-story__stills">
          {% assign stills = 'top,bottom' | split: ',' %}
          {% for still in stills %}
            {% liquid
              assign image_id = 'image_' | append: still
              assign alt_id = 'image_' | append: still | append: '_alt'
              assign caption_id = 'image_' | append: still | append: '_caption'
              assign asset_id = 'image_' | append: still | append: '_asset'
              assign frame_image = section.settings[image_id]
              assign frame_alt = section.settings[alt_id]
              assign frame_caption = section.settings[caption_id]
              assign frame_asset = section.settings[asset_id]
            %}
            <figure class="craft-story__frame craft-story__frame--still">
              <div class="craft-story__media">
                {% if frame_image != blank %}
                  {{
                    frame_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '400, 700, 1000, 1400',
                      sizes: '(min-width: 750px) 22vw, 50vw',
                      class: 'craft-story__image',
                      loading: 'lazy',
                      alt: frame_alt
                  }}
                {% elsif frame_asset != blank %}
                  <img
                    class="craft-story__image"
                    src="{{ frame_asset | asset_url }}"
                    alt="{{ frame_alt | escape }}"
                    width="1024"
                    height="1024"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'craft-story__image craft-story__image--placeholder' }}
                {% endif %}
              </div>
              {% if frame_caption != blank %}
                <figcaption class="craft-story__caption">{{ frame_caption | escape }}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      </div>

      <div class="craft-story__aside">
        {% liquid
          assign feature_image = section.settings.image_feature
          assign feature_alt = section.settings.image_feature_alt | default: 'Wallpaper hung in a bedroom with plantation shutters'
          assign feature_asset = section.settings.image_feature_asset | default: 'craft-still-windows.jpg'
        %}
        <figure class="craft-story__feature">
          <div class="craft-story__media">
            {% if feature_image != blank %}
              {{
                feature_image
                | image_url: width: 2000
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000',
                  sizes: '(min-width: 750px) 38vw, 100vw',
                  class: 'craft-story__image',
                  loading: 'lazy',
                  alt: feature_alt
              }}
            {% elsif feature_asset != blank %}
              <img
                class="craft-story__image"
                src="{{ feature_asset | asset_url }}"
                alt="{{ feature_alt | escape }}"
                width="1024"
                height="682"
                loading="lazy"
              >
            {% endif %}
          </div>
        </figure>

        {% if section.settings.closing != blank
          or section.settings.closing_secondary != blank
          or section.settings.closing_location != blank
        %}
          <div class="craft-story__close">
            {% if section.settings.closing != blank %}
              <p class="craft-story__close-title">{{ section.settings.closing | escape }}</p>
            {% endif %}
            {% if section.settings.closing_secondary != blank %}
              <p class="craft-story__close-lede">{{ section.settings.closing_secondary | escape }}</p>
            {% endif %}
            {% if section.settings.closing_location != blank %}
              <p class="craft-story__close-meta">{{ section.settings.closing_location | escape }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

  </div>

    {% if section.settings.points_heading != blank or section.blocks.size > 0 %}
      <div class="craft-story__apart">
        {% if section.settings.points_heading != blank %}
          <h3 class="craft-story__points-heading">{{ section.settings.points_heading | escape }}</h3>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <div class="craft-story__points" data-apart-points>
            {% for block in section.blocks %}
              <details
                class="craft-story__point"
                {% if forloop.first %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="craft-story__point-summary">
                  <span class="craft-story__point-index">{{ forloop.index | prepend: '0' }}</span>
                  {% if block.settings.heading != blank %}
                    <span class="craft-story__point-heading">{{ block.settings.heading | escape }}</span>
                  {% endif %}
                </summary>
                {% if block.settings.text != blank %}
                  <p class="craft-story__point-text">{{ block.settings.text | escape }}</p>
                {% endif %}
                <div class="craft-story__point-figure">
                  {% if block.settings.image != blank %}
                    {% assign point_image_alt = block.settings.image_alt | default: block.settings.heading %}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        widths: '400, 700, 1000, 1400, 1600',
                        sizes: '(min-width: 750px) 42vw, 92vw',
                        class: 'craft-story__point-image',
                        loading: 'lazy',
                        alt: point_image_alt
                    }}
                  {% else %}
                    {% liquid
                      assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1
                      assign placeholder_name = 'lifestyle-' | append: placeholder_index
                    %}
                    {{ placeholder_name | placeholder_svg_tag: 'craft-story__point-image craft-story__point-image--placeholder' }}
                  {% endif %}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
</div>

<script
  src="{{ 'craft-story-apart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  .craft-story__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 5vw, 4.5rem);
    width: 100%;
  }

  .craft-story__mast {
    display: grid;
    gap: 1.25rem;
    align-items: end;
  }

  .craft-story__heading {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .craft-story__lede {
    margin: 0;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .craft-story__stage {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
  }

  .craft-story__frames {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 28rem;
    margin: 0;
  }

  .craft-story__stills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .craft-story__frame {
    margin: 0;
  }

  .craft-story__media {
    position: relative;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .craft-story__frame--video .craft-story__media {
    aspect-ratio: 9 / 16;
  }

  .craft-story__frame--still .craft-story__media {
    aspect-ratio: 1;
  }

  .craft-story__image,
  .craft-story__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .craft-story__caption {
    margin: 0.7rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .craft-story__apart {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-inline: var(--page-margin);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    box-sizing: border-box;
  }

  .section--page-width > .craft-story__apart {
    grid-column: 1 / -1;
  }

  .craft-story__points-heading {
    margin: 0 0 1rem;
    flex-shrink: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .craft-story__points {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .craft-story__point {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    padding: 1.15rem 0;
    overflow: hidden;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    cursor: pointer;
    transition: flex 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .craft-story__point:first-child {
    border-block-start: 0;
  }

  .craft-story__point[open] {
    flex: 2.4 1 0;
  }

  .craft-story__point-summary {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    list-style: none;
    cursor: pointer;
  }

  .craft-story__point-summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
  }

  .craft-story__point-summary::-webkit-details-marker {
    display: none;
  }

  .craft-story__point-index {
    font-family: var(--font-heading--family);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    opacity: 0.45;
  }

  .craft-story__point-heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .craft-story__point-text {
    margin: 0.7rem 0 0;
    max-width: 28rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .craft-story__point-figure {
    position: relative;
    overflow: hidden;
    margin: 0.85rem 0 0;
    min-height: 0;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .craft-story__point-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .craft-story__point-image--placeholder {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .craft-story__point:not([open]) .craft-story__point-text,
    .craft-story__point:not([open]) .craft-story__point-figure {
      display: none;
    }

    .craft-story__point-figure {
      aspect-ratio: 4 / 3;
    }
  }

  .craft-story__aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    min-width: 0;
  }

  .craft-story__feature {
    margin: 0;
  }

  .craft-story__feature .craft-story__media {
    aspect-ratio: 16 / 10;
  }

  .craft-story__close {
    display: grid;
    gap: 0.7rem;
    max-width: 46rem;
  }

  .craft-story__close-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .craft-story__close-lede {
    margin: 0.45rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .craft-story__close-meta {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.58);
  }

  @media screen and (min-width: 750px) {
    .craft-story__mast {
      grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.95fr);
      gap: 2.5rem;
    }

    .craft-story__stage {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.8fr);
      gap: 2.5rem 3rem;
      align-items: stretch;
    }

    .craft-story__aside {
      min-height: 100%;
    }

    .craft-story__feature {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 16rem;
    }

    .craft-story__feature .craft-story__media {
      flex: 1 1 auto;
      width: 100%;
      height: 100%;
      min-height: 16rem;
      aspect-ratio: auto;
    }

    .craft-story__frames {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: 1rem 1.15rem;
      align-items: stretch;
      width: 100%;
      max-width: none;
    }

    .craft-story__stills {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
      grid-template-columns: none;
      min-height: 100%;
    }

    .craft-story__frame--still {
      flex: 0 0 auto;
    }

    .section--page-width > .craft-story__apart {
      padding-block: 1.5rem 0;
    }

    .craft-story__points-heading {
      margin-bottom: 1.25rem;
    }

    .craft-story__points {
      flex-direction: row;
      border-block: 0;
    }

    .craft-story__point {
      padding: 1.75rem 1.5rem 1.6rem;
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
      overflow: hidden;
      position: relative;
    }

    .craft-story__point:first-child {
      border-inline-start: 0;
      padding-inline-start: 0;
    }

    .craft-story__point:last-child {
      padding-inline-end: 0;
    }

    .craft-story__point[open] {
      flex: 2.8 1 0;
    }

    .craft-story__point-text,
    .craft-story__point-figure {
      display: block;
    }

    .craft-story__point-summary {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      flex: 1 0 auto;
      min-height: 0;
      width: 100%;
      gap: 0;
      transition: flex 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .craft-story__point-summary::after {
      content: '';
      flex: 1 0 0;
      order: 2;
      min-height: 0;
      min-width: 0;
      pointer-events: none;
      transition: flex 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .craft-story__point[open] .craft-story__point-summary {
      flex: 0 0 auto;
    }

    .craft-story__point[open] .craft-story__point-summary::after {
      flex: 0 0 0;
    }

    .craft-story__point-index {
      order: 1;
      flex: 0 0 auto;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      letter-spacing: -0.05em;
      opacity: 0.16;
    }

    .craft-story__point-heading {
      order: 3;
      flex: 0 0 auto;
      width: 100%;
      margin-block-start: 0.45rem;
      font-size: 1.125rem;
      letter-spacing: -0.02em;
      line-height: 1.25;
      white-space: normal;
      overflow-wrap: break-word;
      text-wrap: pretty;
      transition: font-size 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .craft-story__point[open] .craft-story__point-heading {
      font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    }

    .craft-story__point-text {
      flex: 0 0 auto;
      max-height: 0;
      margin-block-start: 0;
      opacity: 0;
      transform: translateY(0.4rem);
      overflow: hidden;
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        max-height 0s linear,
        margin 0s linear;
    }

    .craft-story__point[open] .craft-story__point-text {
      max-height: 8em;
      margin-block-start: 0.85rem;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .craft-story__points[data-apart-ready] .craft-story__point[open] .craft-story__point-text {
      transition:
        opacity 0.4s ease 0.7s,
        transform 0.4s ease 0.7s,
        max-height 0s linear 0.7s,
        margin 0s linear 0.7s;
    }

    .craft-story__point-figure {
      flex: 0 0 0;
      width: 100%;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      transition:
        flex 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.5s ease 0.15s,
        margin 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .craft-story__point[open] .craft-story__point-figure {
      flex: 1 1 0;
      margin-block-start: 1.1rem;
      opacity: 1;
      pointer-events: auto;
    }

    .craft-story__point-image {
      position: absolute;
      inset: 0;
    }

    .craft-story__close {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      max-width: none;
      align-self: stretch;
      flex: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .craft-story__point,
    .craft-story__point-summary,
    .craft-story__point-summary::after,
    .craft-story__point-heading,
    .craft-story__point-figure {
      transition: none;
    }

    .craft-story__point-text,
    .craft-story__points[data-apart-ready] .craft-story__point[open] .craft-story__point-text {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Craft story",
  "tag": "section",
  "class": "craft-story-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Four generations, since 1926"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A century of experience, passed down and reflected in the craftsmanship."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Done once.\nDone right."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "Robert Bryant started hanging wallpaper in London in 1926. Four generations later, his family is still the one on the ladder on the Gold Coast and in Brisbane. We take our own measurements, we are fully insured, and we stay until the wall is right. That is how we got more than a hundred five-star reviews."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "text",
      "id": "video_file",
      "label": "Video filename",
      "info": "Theme asset, such as craft-story.mp4.",
      "default": "craft-story.mp4"
    },
    {
      "type": "text",
      "id": "video_alt",
      "label": "Video description",
      "default": "Wallpaper Gurus installer at work in a high-rise home"
    },
    {
      "type": "text",
      "id": "video_caption",
      "label": "Video caption",
      "default": "At work"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top right image"
    },
    {
      "type": "text",
      "id": "image_top_asset",
      "label": "Top right image filename",
      "info": "Used when no image is selected above.",
      "default": "craft-still-windows.jpg"
    },
    {
      "type": "text",
      "id": "image_top_alt",
      "label": "Top right alt text",
      "default": "Striped wallpaper in a bedroom with plantation shutters"
    },
    {
      "type": "text",
      "id": "image_top_caption",
      "label": "Top right caption",
      "default": "Feature wall"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom right image"
    },
    {
      "type": "text",
      "id": "image_bottom_asset",
      "label": "Bottom right image filename",
      "info": "Used when no image is selected above.",
      "default": "craft-still-texture.jpg"
    },
    {
      "type": "text",
      "id": "image_bottom_alt",
      "label": "Bottom right alt text",
      "default": "Textured wallpaper behind a bed"
    },
    {
      "type": "text",
      "id": "image_bottom_caption",
      "label": "Bottom right caption",
      "default": "Bedroom"
    },
    {
      "type": "image_picker",
      "id": "image_feature",
      "label": "Large image above closing text"
    },
    {
      "type": "text",
      "id": "image_feature_asset",
      "label": "Large image filename",
      "info": "Used when no image is selected above.",
      "default": "craft-still-windows.jpg"
    },
    {
      "type": "text",
      "id": "image_feature_alt",
      "label": "Large image alt text",
      "default": "Striped wallpaper in a bedroom with plantation shutters"
    },
    {
      "type": "header",
      "content": "What sets us apart"
    },
    {
      "type": "text",
      "id": "points_heading",
      "label": "Points heading",
      "default": "What sets us apart"
    },
    {
      "type": "header",
      "content": "Closing"
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Title",
      "default": "Wallpaper Installation, Perfected by The Wallpaper Gurus."
    },
    {
      "type": "textarea",
