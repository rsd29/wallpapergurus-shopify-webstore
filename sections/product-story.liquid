{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="product-story section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="product-story__inner">
    {% if section.settings.heading != blank %}
      <h2 class="product-story__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="product-story__grid">
      <article class="product-story__item">
        <h3 class="product-story__title">{{ section.settings.col_1_heading | escape }}</h3>
        <p class="product-story__copy">{{ section.settings.col_1_copy | escape }}</p>
      </article>
      <article class="product-story__item">
        <h3 class="product-story__title">{{ section.settings.col_2_heading | escape }}</h3>
        <p class="product-story__copy">{{ section.settings.col_2_copy | escape }}</p>
      </article>
      <article class="product-story__item">
        <h3 class="product-story__title">{{ section.settings.col_3_heading | escape }}</h3>
        <p class="product-story__copy">{{ section.settings.col_3_copy | escape }}</p>
      </article>
    </div>
  </div>
</div>

{% stylesheet %}
  .product-story__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .product-story__heading {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .product-story__grid {
    display: grid;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .product-story__item {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.5rem 0;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  .product-story__item:first-child {
    border-block-start: 0;
  }

  .product-story__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .product-story__copy {
    margin: 0;
    max-width: 28rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  @media screen and (min-width: 750px) {
    .product-story__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-story__item {
      padding: 1.75rem 1.75rem 1.75rem 0;
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    }

    .product-story__item:first-child {
      border-inline-start: 0;
      padding-inline-start: 0;
    }

    .product-story__item:not(:first-child) {
      padding-inline-start: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "class": "product-story-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to be hung once."
    },
    {
      "type": "text",
      "id": "col_1_heading",
      "label": "Column 1 heading",
      "default": "The paper"
    },
    {
      "type": "textarea",
      "id": "col_1_copy",
      "label": "Column 1 copy",
      "default": "Texture, colour, and repeat chosen because they install well. These are papers we put on walls ourselves."
    },
    {
      "type": "text",
      "id": "col_2_heading",
      "label": "Column 2 heading",
      "default": "The match"
    },
    {
      "type": "textarea",
      "id": "col_2_copy",
      "label": "Column 2 copy",
      "default": "Order enough in one dye lot. We can advise on drop, waste, and how many rolls the room actually needs."
    },
    {
      "type": "text",
      "id": "col_3_heading",
      "label": "Column 3 heading",
      "default": "The hang"
    },
    {
      "type": "textarea",
      "id": "col_3_copy",
      "label": "Column 3 copy",
      "default": "Wallpaper Gurus can measure and hang this paper on the Gold Coast and in Brisbane. Fully insured. Father and son on the ladder."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product story"
    }
  ]
}
{% endschema %}
