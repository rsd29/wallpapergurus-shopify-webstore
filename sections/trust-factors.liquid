{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="trust-factors section section--{{ section.settings.section_width }} section--full-viewport spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="trust-factors__inner">
  {% if section.settings.heading != blank or section.settings.subheading != blank or section.settings.button_label != blank %}
    <div class="trust-factors__intro">
      <div class="trust-factors__copy">
        {% if section.settings.heading != blank %}
          <h2 class="trust-factors__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="trust-factors__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <a
          class="button trust-factors__cta"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <ul class="trust-factors__list" role="list">
      {% for block in section.blocks %}
        <li class="trust-factors__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != 'none' or block.settings.image_upload != blank %}
            <span class="trust-factors__icon" aria-hidden="true">
              {% render 'icon-or-image',
                icon: block.settings.icon,
                image_upload: block.settings.image_upload,
                width: 28,
                class_name: 'trust-factors__icon-media'
              %}
            </span>
          {% endif %}

          <div class="trust-factors__item-copy">
            {% if block.settings.heading != blank %}
              <h3 class="trust-factors__item-heading">{{ block.settings.heading | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="trust-factors__item-text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  </div>
</div>

{% stylesheet %}
  .trust-factors.section--full-viewport {
    --section-min-height: 100svh;
    align-content: center;
  }

  .trust-factors__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .trust-factors__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .trust-factors__copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 40rem;
  }

  .trust-factors__heading {
    margin: 0;
    font-size: var(--font-size--heading-lg, 1.75rem);
    line-height: 1.2;
  }

  .trust-factors__subheading {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .trust-factors__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-factors__item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .trust-factors__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: currentColor;
  }

  .trust-factors__icon-media {
    display: block;
  }

  .trust-factors__item-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .trust-factors__item-heading {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
  }

  .trust-factors__item-text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  @media screen and (min-width: 750px) {
    .trust-factors__intro {
      flex-direction: row;
      align-items: flex-end;
    }

    .trust-factors__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust factors",
  "tag": "section",
  "class": "trust-factors-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "factor",
      "name": "Trust factor",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "silhouette", "label": "People" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "check_box", "label": "Check" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "map_pin", "label": "Map pin" }
          ],
          "default": "star"
        },
        {
          "type": "image_picker",
          "id": "image_upload",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Trusted installers"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Professional wallpaper hanging for homes and workplaces."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wallpaper hanging you can trust"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Four generations of installers. Measured, hung, and finished properly."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Trust factors",
      "category": "t:categories.text",
      "blocks": {
        "generations": {
          "type": "factor",
          "settings": {
            "icon": "silhouette",
            "heading": "Four generations",
            "text": "Wallpaper hanging since 1926."
          }
        },
        "insured": {
          "type": "factor",
          "settings": {
            "icon": "lock",
            "heading": "Fully insured",
            "text": "Professional installers you can book with confidence."
          }
        },
        "reviews": {
          "type": "factor",
          "settings": {
            "icon": "star",
            "heading": "100+ five-star reviews",
            "text": "Trusted by homes and businesses on the Gold Coast and in Brisbane."
          }
        },
        "scope": {
          "type": "factor",
          "settings": {
            "icon": "ruler",
            "heading": "Residential & commercial",
            "text": "From a single feature wall to large-scale fit-outs."
          }
        }
      },
      "block_order": ["generations", "insured", "reviews", "scope"]
    }
  ]
}
{% endschema %}
