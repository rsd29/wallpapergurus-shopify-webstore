{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign rating_label = section.settings.rating | default: '5.0'
  assign review_count = section.settings.review_count | default: '121'
  assign view_all_label = section.settings.view_all_label
  assign cta_label = section.settings.cta_label
  assign perfect_score_label = section.settings.perfect_score_label
  assign google_url = section.settings.google_url
  if google_url == blank
    assign google_url = 'https://share.google/oi3b92iWDNWKOzf9X'
  endif
  assign rating_number = rating_label | plus: 0
  if rating_number == 0
    assign rating_number = 5
  endif
  assign filled_stars = rating_number | floor
  if rating_number > filled_stars
    assign filled_stars = filled_stars | plus: 1
  endif
  if filled_stars > 5
    assign filled_stars = 5
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<google-reviews
  class="google-reviews section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-google-url="{{ google_url | escape }}"
>
  <div class="google-reviews__inner">
    <header class="google-reviews__header">
      <div class="google-reviews__intro">
        {% if heading != blank %}
          <h2 class="google-reviews__heading">{{ heading | escape }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="google-reviews__subhead">{{ subheading | escape }}</p>
        {% endif %}
      </div>

      <a
        class="google-reviews__summary"
        href="{{ google_url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ rating_label | escape }} from {{ review_count | escape }} Google reviews. {{ perfect_score_label | default: 'Every review is 5 stars.' | escape }} Open Wallpaper Gurus on Google."
      >
        {% render 'icon-google-g', class: 'google-reviews__g google-reviews__g--summary' %}

        <div class="google-reviews__score">
          <p class="google-reviews__rating">{{ rating_label | escape }}</p>
          <div class="google-reviews__stars google-reviews__stars--summary" aria-hidden="true">
            {% for i in (1..5) %}
              <svg
                class="google-reviews__star{% if i > filled_stars %} google-reviews__star--empty{% endif %}"
                viewBox="0 0 24 24"
                focusable="false"
              >
                <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
            {% endfor %}
          </div>
        </div>

        <div class="google-reviews__proof">
          <p class="google-reviews__count">{{ review_count | escape }} Google reviews</p>
          {% if perfect_score_label != blank %}
            <p class="google-reviews__perfect">{{ perfect_score_label | escape }}</p>
          {% endif %}
        </div>

        {% if view_all_label != blank %}
          <span class="google-reviews__all">{{ view_all_label | escape }}</span>
        {% endif %}
      </a>
    </header>
  </div>

  <div class="google-reviews__stage force-full-width" data-review-stage>
    <div
      class="google-reviews__row"
      data-review-row
      data-direction="left"
      data-speed="0.038"
    >
      <div class="google-reviews__lane" data-review-lane>
        {% render 'google-reviews-lane',
          blocks: section.blocks,
          row: 0,
          google_url: google_url
        %}
      </div>
    </div>

    <div
      class="google-reviews__row"
      data-review-row
      data-direction="right"
      data-speed="0.05"
    >
      <div class="google-reviews__lane" data-review-lane>
        {% render 'google-reviews-lane',
          blocks: section.blocks,
          row: 1,
          google_url: google_url
        %}
      </div>
    </div>
  </div>

  {% if cta_label != blank %}
    <div class="google-reviews__footer">
      <a
        class="button google-reviews__cta"
        href="{{ google_url }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ cta_label | escape }}
      </a>
    </div>
  {% endif %}
</google-reviews>

<script
  src="{{ 'google-reviews.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  google-reviews.google-reviews {
    display: grid;
    gap: 2rem;
    overflow-x: clip;
  }

  .google-reviews__inner {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .google-reviews__header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .google-reviews__intro {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-width: 40rem;
  }

  .google-reviews__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .google-reviews__subhead {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  a.google-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.85rem 1rem 0.85rem 0.9rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    background: rgb(var(--color-background-rgb) / 1);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.google-reviews__summary:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.28);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.06);
    transform: translateY(-1px);
  }

  .google-reviews__g {
    display: block;
    flex-shrink: 0;
  }

  .google-reviews__g--summary {
    width: 1.7rem;
    height: 1.7rem;
  }

  .google-reviews__g--card {
    width: 1rem;
    height: 1rem;
  }

  .google-reviews__score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .google-reviews__rating {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.15rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .google-reviews__stars {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .google-reviews__star {
    width: 0.9rem;
    height: 0.9rem;
    fill: #fbbc04;
  }

  .google-reviews__star--empty {
    fill: rgb(var(--color-foreground-rgb) / 0.16);
  }

  .google-reviews__stars--summary .google-reviews__star {
    width: 1.15rem;
    height: 1.15rem;
  }

  .google-reviews__proof {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .google-reviews__count,
  .google-reviews__perfect {
    margin: 0;
  }

  .google-reviews__count {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .google-reviews__perfect {
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #0d652d;
  }

  .google-reviews__all {
    margin: 0;
    margin-inline-start: auto;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #1a73e8;
    text-decoration: none;
    white-space: nowrap;
  }

  a.google-reviews__summary:hover .google-reviews__all {
    text-decoration: underline;
  }

  .google-reviews__stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow: hidden;
    padding-block: 0.75rem;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .google-reviews__stage.is-dragging {
    cursor: grabbing;
  }

  .google-reviews__row {
    overflow: hidden;
  }

  .google-reviews__lane {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    width: max-content;
    will-change: transform;
  }

  .google-reviews__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    flex: 0 0 18.75rem;
    width: 18.75rem;
    min-height: 16.25rem;
    padding: 1.2rem 1.2rem 1.1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    background: rgb(var(--color-background-rgb) / 1);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .google-reviews__card:hover {
    z-index: 1;
    border-color: rgb(var(--color-foreground-rgb) / 0.28);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.08);
    transform: translateY(-4px);
  }

  .google-reviews__stage.is-dragging .google-reviews__card,
  .google-reviews__stage.is-dragging .google-reviews__card:hover {
    transform: none;
    box-shadow: none;
    transition: none;
  }

  .google-reviews__person {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-width: 0;
  }

  .google-reviews__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    overflow: hidden;
    border-radius: 50%;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    color: #fff;
    background: var(--google-avatar);
  }

  .google-reviews__avatar[data-tone='0'] {
    --google-avatar: #174ea6;
  }

  .google-reviews__avatar[data-tone='1'] {
    --google-avatar: #0d652d;
  }

  .google-reviews__avatar[data-tone='2'] {
    --google-avatar: #b06000;
  }

  .google-reviews__avatar[data-tone='3'] {
    --google-avatar: #8c1d18;
  }

  .google-reviews__avatar[data-tone='4'] {
    --google-avatar: #7627bb;
  }

  .google-reviews__avatar[data-tone='5'] {
    --google-avatar: #007b83;
  }

  .google-reviews__avatar[data-tone='6'] {
    --google-avatar: #c5221f;
  }

  .google-reviews__avatar[data-tone='7'] {
    --google-avatar: #1967d2;
  }

  .google-reviews__avatar[data-tone='8'] {
    --google-avatar: #e37400;
  }

  .google-reviews__avatar[data-tone='9'] {
    --google-avatar: #188038;
  }

  .google-reviews__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .google-reviews__identity {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    flex: 1;
  }

  .google-reviews__name,
  .google-reviews__date,
  .google-reviews__text {
    margin: 0;
  }

  .google-reviews__name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .google-reviews__date {
    font-size: 0.75rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground-rgb) / 0.52);
  }

  .google-reviews__source {
    display: inline-flex;
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  .google-reviews__text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    flex: 1;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .google-reviews__card.is-expanded .google-reviews__text {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    display: block;
    overflow: visible;
  }

  .google-reviews__card.is-expanded {
    min-height: 16.25rem;
    height: auto;
  }

  .google-reviews__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    margin-top: auto;
  }

  .google-reviews__more,
  .google-reviews__google-link {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #1a73e8;
    text-decoration: none;
    cursor: pointer;
  }

  .google-reviews__more:hover,
  .google-reviews__google-link:hover {
    text-decoration: underline;
  }

  .google-reviews__google-link {
    margin-inline-start: auto;
  }

  .google-reviews__footer {
    display: flex;
    justify-content: flex-start;
  }

  .google-reviews__cta {
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    google-reviews.google-reviews {
      gap: 2.25rem;
    }

    .google-reviews__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem 2rem;
    }

    .google-reviews__stage {
      gap: 1rem;
    }

    .google-reviews__lane {
      gap: 1rem;
    }

    .google-reviews__card {
      flex-basis: 21rem;
      width: 21rem;
      min-height: 17rem;
      padding: 1.35rem 1.4rem 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .google-reviews__stage {
      cursor: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .google-reviews__row {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .google-reviews__row::-webkit-scrollbar {
      display: none;
    }

    .google-reviews__card {
      scroll-snap-align: start;
    }

    .google-reviews__card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Google reviews",
  "tag": "section",
  "class": "google-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 24,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Sarah Mitchell"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "2 weeks ago",
          "info": "Use a relative date, e.g. 2 weeks ago"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Google review link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Ticker of Google reviews. The score badge, card links, and button all open the Google listing."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "121 five-star Google reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Not one of them below five stars."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Overall rating",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "121"
    },
    {
      "type": "text",
      "id": "perfect_score_label",
      "label": "Perfect score label",
      "default": "Every review is 5 stars"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Score badge link label",
      "default": "Read them on Google"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See all 121 five-star reviews on Google"
    },
    {
      "type": "text",
      "id": "google_url",
      "label": "Google reviews URL",
      "default": "https://share.google/oi3b92iWDNWKOzf9X",
      "info": "Opens this Google search / business listing in a new tab"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Google reviews",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
