{%- doc -%}
  One row of Google review cards for the infinite ticker.

  @param {object} [blocks] - Section review blocks
  @param {number} row - 0 or 1; cards are split across the two lanes
  @param {string} google_url - Google business reviews URL
{%- enddoc -%}

{% liquid
  assign lane_row = row | plus: 0
  assign block_count = 0
  if blocks != blank
    assign block_count = blocks.size
  endif
%}

{% if block_count > 0 %}
  {% for block in blocks %}
    {% assign lane_index = forloop.index0 | modulo: 2 %}
    {% if lane_index == lane_row %}
      {% liquid
        assign card_link = block.settings.link
        if card_link == blank
          assign card_link = google_url
        endif
      %}
      {% render 'google-review-card',
        author: block.settings.author,
        date: block.settings.date,
        rating: block.settings.rating,
        text: block.settings.text,
        image: block.settings.image,
        link: card_link,
        tone: forloop.index0,
        shopify_attributes: block.shopify_attributes
      %}
    {% endif %}
  {% endfor %}
{% elsif lane_row == 0 %}
  {% render 'google-review-card',
    author: 'Sarah Mitchell',
    date: '2 weeks ago',
    rating: 5,
    text: 'Absolutely flawless. They hung a feature wall in our living room and the pattern match is perfect down to the millimetre. On time, tidy, and clearly know their craft.',
    link: google_url,
    tone: 0
  %}
  {% render 'google-review-card',
    author: 'Priya Nair',
    date: '3 weeks ago',
