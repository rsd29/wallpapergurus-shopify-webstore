{%- doc -%}
  JSON product payload for name/SKU autocomplete search.

  @param {object} products - Product list to serialize
{%- enddoc -%}

<script type="application/json" data-product-search-data>
  [
    {%- for product in products -%}
      {%- liquid
        assign product_image = product.featured_media.preview_image | default: product.featured_image
        if product_image == blank and product.images.size > 0
          assign product_image = product.images.first
        endif
        assign product_image_url = blank
        if product_image != blank
          assign product_image_url = product_image | image_url: width: 240
        endif
      -%}
      {
        "title": {{ product.title | json }},
        "price": {{ product.price | money | json }},
        "image": {% if product_image_url != blank %}{{ product_image_url | json }}{% else %}null{% endif %},
        "url": {{ product.url | json }},
        "terms": [
          {{ product.title | json }}
          {%- for variant in product.variants -%}
            {%- if variant.sku != blank -%}
              ,{{ variant.sku | json }}
            {%- endif -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
